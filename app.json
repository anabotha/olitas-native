{
  "expo": {
    "name": "Olitas",
    "slug": "olitas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4a90a4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.anabotha.olitas"
    },
    "android": {
      "package": "dev.anabotha.olitas",
      "adaptiveIcon": {
        "backgroundColor": "#4a90a4",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-background-task",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Olitas usa tu ubicación para mostrarte la playa más cercana."
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "OlitasWidget",
              "displayName": "Olitas",
              "description": "La mejor ventana de las próximas horas en tu playa.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./widgets/OlitasWidget.tsx"
              }
            }
          ]
        }
      ]
    ]
  }
}
