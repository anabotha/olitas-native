{
  "expo": {
    "name": "Olitas",
    "slug": "olitas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4a90a4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.anabotha.olitas"
    },
    "android": {
      "package": "dev.anabotha.olitas",
      "adaptiveIcon": {
        "backgroundColor": "#4a90a4",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-background-task",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Olitas usa tu ubicación para mostrarte la playa más cercana."
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "OlitasWidget",
              "displayName": "Olitas",
              "description": "La mejor ventana de las próximas horas en tu playa.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./widgets/OlitasWidget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "dev.anabotha.olitas.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.dev.anabotha.olitas"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "50b7eb88-e5f1-473e-b0c6-8b5f603d52db"
      }
    }
  }
}
